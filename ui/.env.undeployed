# Local undeployed network (midnight-local-dev stack) — Lace wallet only;
# the 1AM wallet cannot connect to undeployed. To use: copy over .env
#   cp .env.undeployed .env   (then restart vite)
# and switch Lace's network setting to "Undeployed".
VITE_NETWORK_ID=undeployed
VITE_INDEXER_URL=http://localhost:8088/api/v3/graphql
VITE_INDEXER_WS_URL=ws://localhost:8088/api/v3/graphql/ws
VITE_NODE_URL=http://localhost:9944
VITE_PROOF_SERVER_URL=http://localhost:6300
VITE_DEFAULT_CONTRACT=
